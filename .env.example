# GitHub App settings:
# - OAuth callback URL: /api/auth/callback
# - Setup URL: /api/github/setup
# - Repository permissions: Contents read/write, Metadata read-only
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Use a single-line PEM with literal \n escapes, or a normal multi-line PEM.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=

# At least 32 random bytes. This encrypts session and OAuth state cookies.
# Example generation: openssl rand -base64 48
SESSION_SECRET=

# Optional. Set this to the canonical site origin in production.
APP_ORIGIN=http://localhost:5173
