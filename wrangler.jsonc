{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "doriya2fa",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
