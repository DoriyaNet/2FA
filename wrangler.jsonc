{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "doriya2fa",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "keep_vars": true,
  "vars": {
    "APP_ORIGIN": "https://2fa.doriya.net",
    "GITHUB_APP_CLIENT_ID": "Iv23ctY49IRGDtPMsVqM",
    "GITHUB_APP_ID": "5645624",
    "GITHUB_APP_SLUG": "doriya2fa"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
